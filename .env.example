# Chaves de provedor: só variáveis de ambiente. O painel /admin/llm guarda apenas o NOME da variável
# e mostra "configurada / não configurada"; o valor nunca é lido, devolvido nem gravado em banco.
# Realtime (áudio ao vivo) SEMPRE usa a OpenAI com esta chave, qualquer que seja TRANSCRIPTION_PROVIDER.
# Com TRANSCRIPTION_PROVIDER=openai também é a chave da transcrição HTTP.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Provedor da transcrição HTTP (chunks, offline, recuperação): openai | openrouter. OBRIGATÓRIO, sem default.
# Ausente ou inválido => transcrição HTTP indisponível com erro nomeado; o servidor ainda sobe.
# Sem fallback: um provedor nunca usa a chave do outro nem assume em caso de erro.
# É o default de ambiente; o admin (/admin/llm) pode sobrescrever por tarefa.
TRANSCRIPTION_PROVIDER=
# Usada apenas com TRANSCRIPTION_PROVIDER=openrouter (chave de projeto/ambiente com teto mensal).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional override for the transcription endpoint only (takes precedence over OPENROUTER_BASE_URL). HTTPS only.
OPENROUTER_TRANSCRIPTION_BASE_URL=
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-transcribe
PORT=3000
UI_ORIGIN=http://127.0.0.1:5179
SESSIONS_DIR=./sessions
DATA_DIR=./data
BROWSER_PROFILE_DIR=./data/browser-profile
DIAGNOSTIC_TRACE=false
HOST=127.0.0.1
# Bearer exigido em todas as rotas, exceto /health, / e /demo, quando preenchido.
API_TOKEN=
# Perfil admin do painel /admin/llm. Se preenchido, só ele abre /admin/*. Se vazio, o API_TOKEN apenas CONSULTA
# o painel (alterar rotas, orçamento, tarifas e testar conexão exige ADMIN_TOKEN); sem nenhum dos dois, /admin só
# responde com HOST em loopback e requisição direta (cabeçalhos de proxy/túnel fecham o painel).
ADMIN_TOKEN=
# Nomes extras de variável de chave que o admin pode escolher por provedor (lista separada por vírgula; só nomes
# *_API_KEY). Vazio = só OPENAI_API_KEY / OPENROUTER_API_KEY / ANTHROPIC_API_KEY, respectivamente.
LLM_KEY_REFS_OPENAI=
LLM_KEY_REFS_OPENROUTER=
LLM_KEY_REFS_ANTHROPIC=
# Postgres do db01. Vazio mantém o índice em arquivo (modo local / testes).
DATABASE_URL=
# MinIO do homelab. Bucket review-recorder. Vazio grava só em disco.
S3_ENDPOINT=
S3_BUCKET=review-recorder
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
