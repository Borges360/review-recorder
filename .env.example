# Realtime (live audio) ALWAYS uses OpenAI with this key, whatever TRANSCRIPTION_PROVIDER says.
# With TRANSCRIPTION_PROVIDER=openai it is also the HTTP transcription key.
OPENAI_API_KEY=
# HTTP transcription provider (chunks, offline, recovery): openai | openrouter. REQUIRED, no default.
# Missing or invalid => HTTP transcription unavailable with a named error; the server still boots.
# No fallback: one provider never uses the other's key nor takes over on error.
TRANSCRIPTION_PROVIDER=
# Used only when TRANSCRIPTION_PROVIDER=openrouter (project/environment key with a monthly cap).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional override for the transcription endpoint only (takes precedence over OPENROUTER_BASE_URL). HTTPS only.
OPENROUTER_TRANSCRIPTION_BASE_URL=
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-transcribe
PORT=3000
UI_ORIGIN=http://127.0.0.1:5179
SESSIONS_DIR=./sessions
DATA_DIR=./data
BROWSER_PROFILE_DIR=./data/browser-profile
DIAGNOSTIC_TRACE=false
HOST=127.0.0.1
# Bearer exigido em todas as rotas, exceto /health, / e /demo, quando preenchido.
API_TOKEN=
# Postgres do db01. Vazio mantém o índice em arquivo (modo local / testes).
DATABASE_URL=
# MinIO do homelab. Bucket review-recorder. Vazio grava só em disco.
S3_ENDPOINT=
S3_BUCKET=review-recorder
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
