{
  "name": "review-recorder",
  "version": "1.0.0",
  "private": true,
  "description": "Voice UI Review Recorder — timeline semântica de revisões web",
  "workspaces": [
    "server",
    "ui"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server & npm run dev --workspace=ui",
    "dev:server": "npm run dev --workspace=server",
    "dev:ui": "npm run dev --workspace=ui",
    "build": "npm run build --workspace=server && npm run build --workspace=ui",
    "test": "npm run test --workspace=server",
    "test:e2e": "npm run test:e2e --workspace=server",
    "compile": "npm run compile --workspace=server",
    "start": "npm run start --workspace=server",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@typescript-eslint/eslint-plugin": "^8.33.1",
    "@typescript-eslint/parser": "^8.33.1",
    "eslint": "^9.28.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.33.1"
  }
}
