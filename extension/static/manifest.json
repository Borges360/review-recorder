{
  "manifest_version": 3,
  "name": "Review Recorder",
  "version": "1.0.0",
  "description": "Grava revisão falada da aba atual e envia para a API configurável do homelab.",
  "permissions": ["sidePanel", "offscreen", "storage", "tabs", "scripting", "webNavigation", "activeTab", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Review Recorder" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
